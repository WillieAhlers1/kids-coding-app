{
  "name": "kids-coding-app",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:child": "npm run dev -w apps/child-client",
    "dev:adult": "npm run dev -w apps/adult-portal",
    "dev:api": "npm run dev -w services/platform-api"
  },
  "engines": {
    "node": ">=18.15.0"
  }
}
